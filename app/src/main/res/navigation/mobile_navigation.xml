<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_home">

    <!-- 🏠 Tela inicial - Home -->
    <fragment
        android:id="@+id/navigation_home"
        android:name="com.ifpr.androidapptemplate.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_navigation_home_to_imovelMapFragment"
            app:destination="@id/imovelMapFragment" />
    </fragment>

    <!-- 🏢 Lista de imóveis -->
    <fragment
        android:id="@+id/navigation_imoveis"
        android:name="com.ifpr.androidapptemplate.ui.imovel.ImovelListFragment"
        android:label="@string/title_imoveis"
        tools:layout="@layout/fragment_imovel_list" />

    <!-- 🗺️ Mapa de imóveis -->
    <fragment
        android:id="@+id/imovelMapFragment"
        android:name="com.ifpr.androidapptemplate.ui.map.ImovelMapFragment"
        android:label="Mapa de Imóveis"
        tools:layout="@layout/fragment_imovel_map" />

    <!-- 🔔 Notificações -->
    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.ifpr.androidapptemplate.ui.notifications.NotificationsFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_notifications" />

    <!-- 👤 Perfil do usuário -->
    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.ifpr.androidapptemplate.ui.usuario.PerfilUsuarioFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_perfil_usuario">
        <action
            android:id="@+id/action_navigation_profile_to_todosImoveisFragment"
            app:destination="@id/todosImoveisFragment" />
    </fragment>

    <fragment
        android:id="@+id/todosImoveisFragment"
        android:name="com.ifpr.androidapptemplate.ui.imoveis.TodosImoveisFragment"
        android:label="Todos os Imóveis"
        tools:layout="@layout/fragment_todos_imoveis" />

</navigation>