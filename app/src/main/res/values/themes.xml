<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AndroidAppTemplate" parent="Theme.Material3.DayNight">
        <!-- Color system -->
        <item name="colorPrimary">@color/brown_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brown_light</item>
        <item name="colorOnPrimaryContainer">@color/brown_dark</item>
        <item name="colorSecondary">@color/beige_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/beige_dark</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
        <item name="android:colorBackground">@color/light_gray</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/light_gray</item>
        <item name="colorOnSurfaceVariant">@color/gray</item>
        <item name="colorOutline">@color/gray</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/brown_dark</item>
    </style>
</resources>
